{
  "functions": {
    "app/api/parse/route.ts": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/upload/route.ts": {
      "maxDuration": 60,
      "memory": 512
    },
    "app/api/meal-plan/route.ts": {
      "maxDuration": 60,
      "memory": 512
    },
    "app/api/deals/route.ts": {
      "maxDuration": 30,
      "memory": 256
    },
    "app/api/cron/deals-refresh/route.ts": {
      "maxDuration": 30,
      "memory": 256
    },
    "app/api/cron/weekly-meal-plan/route.ts": {
      "maxDuration": 60,
      "memory": 512
    },
    "app/api/cron/review-queue-reminder/route.ts": {
      "maxDuration": 30,
      "memory": 256
    }
  },
  "crons": [
    {
      "path": "/api/cron/deals-refresh",
      "schedule": "0 6 * * 3"
    },
    {
      "path": "/api/cron/weekly-meal-plan",
      "schedule": "15 6 * * 4"
    },
    {
      "path": "/api/cron/review-queue-reminder",
      "schedule": "0 7 * * *"
    }
  ]
}
